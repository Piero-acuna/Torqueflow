{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/auth/:path*",           "destination": "/api/auth" },
    { "source": "/api/orders/:path*",          "destination": "/api/orders" },
    { "source": "/api/parts/:path*",           "destination": "/api/parts" },
    { "source": "/api/mechanics/:path*",       "destination": "/api/mechanics" },
    { "source": "/api/services/:path*",        "destination": "/api/services" },
    { "source": "/api/clients/:path*",         "destination": "/api/clients" },
    { "source": "/api/vehicles/:path*",        "destination": "/api/vehicles" },
    { "source": "/api/workshops/:path*",       "destination": "/api/workshops" },
    { "source": "/api/stock-movements/:path*", "destination": "/api/stock-movements" },
    { "source": "/api/vin-decode",             "destination": "/api/vin-decode" },
    { "source": "/api/admin/:path*",           "destination": "/api/admin" }
  ]
}